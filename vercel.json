{
  "routes": [
    {
      "src": "/api/chat",
      "dest": "/api/chat.js",
      "methods": ["POST", "OPTIONS"]
    },
    {
      "src": "/api/transcribe",
      "dest": "/api/transcribe.js",
      "methods": ["POST", "OPTIONS"]
    },
    {
      "src": "/(?!api/).*\\.(css|js)$",
      "dest": "/$1",
      "headers": {
        "Cache-Control": "public, max-age=60, s-maxage=60"
      }
    },
    {
      "src": "/(?!api/)(.*\\.(json|png|jpg|jpeg|gif|svg|ico|woff|woff2|eot|ttf|otf|webp|pdf)$|.*\/$)",
      "dest": "/$1",
      "headers": {
        "Cache-Control": "public, max-age=3600, s-maxage=3600"
      }
    },
    {
      "src": "/(?!api/).*\\.html$",
      "dest": "/$1"
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ]
}
